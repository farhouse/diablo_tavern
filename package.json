{
  "name": "diablo-management",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "pretest": "nuxt prepare",
    "test": "vitest run",
    "test:e2e:responsive": "playwright test --config playwright.config.ts",
    "test:e2e:persisted": "test -n \"$MONGO_TEST_URI\" && MONGO_URI=\"$MONGO_TEST_URI\" playwright test --config playwright.config.ts tests/e2e/visitor-round.pw.ts",
    "contract:validate": "node scripts/validate-v2-etapa0-3.mjs",
    "generate:v2-types": "node scripts/generate-v2-game-view-types.mjs",
    "check:v2-types": "node scripts/generate-v2-game-view-types.mjs --check",
    "typecheck": "nuxt typecheck"
  },
  "dependencies": {
    "@nuxt/ui": "^3.1.3",
    "@pinia/nuxt": "^0.11.1",
    "bcryptjs": "^3.0.2",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.16.0",
    "nuxt": "^4.0.0",
    "pinia": "^3.0.2",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.5.0",
    "ajv": "8.17.1",
    "ajv-formats": "^3.0.1",
    "dotenv": "^17.4.2",
    "fast-check": "^4.10.0",
    "happy-dom": "^20.14.3",
    "typescript": "^5.8.3",
    "vitest": "^3.1.3",
    "vue-tsc": "^3.3.3"
  }
}
